# Exclude generated analytics outputs
analytics/outputs/*

# Keep the ML model directory
!analytics/outputs/ml/
analytics/outputs/ml/*
!analytics/outputs/ml/models/
analytics/outputs/ml/models/*
!analytics/outputs/ml/models/*.joblib

# Exclude Power BI file
*.pbix
analytics/outputs/powerbi/
