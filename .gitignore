
# Python virtual environment
backend/venv/

# Environment variables and secrets
backend/.env

# Python cache files
__pycache__/
*.py[cod]

# Environment and editor files
.env
.vscode/
*.mwb.bak
backend/uploads/

# Frontend dependencies and production build
frontend/node_modules/
frontend/dist/


# CivicTrack analytics generated outputs
analytics/__pycache__/
